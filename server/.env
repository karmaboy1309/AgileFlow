# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB Atlas Connection ─────────────────────────────────────────────────
# YOUR CLUSTER: agileflow-cluster.idsoxfy.mongodb.net
# ⚠️  IMPORTANT: Replace YOUR_PASSWORD_HERE with your actual database user password
#
MONGODB_URI=mongodb://127.0.0.1:27017/agileflow

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Keep this secret — never share or commit this value!
JWT_SECRET=agileflow_change_this_to_a_long_random_secret_string_123456
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# The URL of your Vite frontend dev server
CLIENT_ORIGIN=http://localhost:5173
