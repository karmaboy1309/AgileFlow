# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agileflow?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -base64 64).
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173
